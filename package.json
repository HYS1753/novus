{
  "name": "novus",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "vite",
    "build": "pnpm release:check && tsc && vite build",
    "preview": "vite preview",
    "icons:generate": "node scripts/app-icons.mjs",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release:check": "node scripts/release.mjs check",
    "release:keygen": "node scripts/update-key.mjs",
    "release:signing": "node scripts/update-artifacts.mjs",
    "release:ci": "node scripts/ci-release.mjs",
    "release:version": "node scripts/release.mjs set",
    "release:info": "node scripts/release.mjs info",
    "release:test": "node --test scripts/release.test.mjs scripts/update-artifacts.test.mjs scripts/ci-release.test.mjs scripts/publish-release.test.mjs",
    "update:test": "node --test scripts/update-controller.test.mjs scripts/update-qa.test.mjs scripts/theme.test.mjs",
    "release:build:windows": "pnpm release:check && pnpm release:signing check && pnpm tauri build --target x86_64-pc-windows-msvc --bundles nsis -- --locked",
    "setup:mpv": "python3 scripts/setup_mpv.py || python scripts/setup_mpv.py",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^26.6.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.11.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.0.16"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yaml,yml}": [
      "prettier --write"
    ]
  }
}
